# Database (Supabase connection string com pgbouncer)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true

# Supabase
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Groq AI (fallback/opcional)
GROQ_API_KEY=gsk_...

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=3333
NODE_ENV=development
UPLOAD_DIR=./uploads

# Classification engine: gemini | groq | keyword
CLASSIFICATION_ENGINE=gemini

# CORS — URL do frontend em produção (separar múltiplos com vírgula)
FRONTEND_URL=http://localhost:5173
