# Database (Supabase connection string com pgbouncer)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true

# Supabase
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Groq AI
GROQ_API_KEY=gsk_...

# Server
PORT=3333
NODE_ENV=development
UPLOAD_DIR=./uploads

# Classification engine: groq | keyword
CLASSIFICATION_ENGINE=groq

# CORS — URL do frontend em produção (separar múltiplos com vírgula)
FRONTEND_URL=http://localhost:5173

# Segredo compartilhado com o agendador externo (GitHub Actions) que chama
# GET /email/cron-sync a cada 15 min — necessário porque a Vercel não mantém
# processos em segundo plano para o @Cron do NestJS funcionar sozinho.
CRON_SECRET=
