{
  "version": 2,
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://new-system-talentfit.vercel.app",
        "Access-Control-Allow-Methods": "GET,POST,PUT,PATCH,DELETE,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type,Authorization,Accept",
        "Access-Control-Allow-Credentials": "true"
      },
      "status": 200,
      "continue": false
    },
    {
      "src": "/(.*)",
      "dest": "dist/main.js",
      "headers": {
        "Access-Control-Allow-Origin": "https://new-system-talentfit.vercel.app",
        "Access-Control-Allow-Credentials": "true"
      }
    }
  ]
}
